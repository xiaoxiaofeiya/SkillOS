  "description": "Client adapters and presets for Codex, Claude Code, Cursor, Windsurf, OpenHands, OpenClaw, and OpenClaw-like runtimes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiaofeiya/SkillOS.git",
    "directory": "packages/adapters"
  },
  "type": "module",
